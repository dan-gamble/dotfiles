#!/usr/bin/env python3
import json, os, socket, subprocess, sys

step = sys.argv[1]
sock = os.environ.get("HERDR_SOCKET_PATH", os.path.expanduser("~/.config/herdr/herdr.sock"))

def call(method, params):
    s = socket.socket(socket.AF_UNIX)
    s.connect(sock)
    s.sendall((json.dumps({"id": "scroll", "method": method, "params": params}) + "\n").encode())
    reply = json.loads(s.makefile().readline())
    s.close()
    return reply["result"]["pane"]

env = {k: v for k, v in os.environ.items() if k != "HERDR_PANE_ID"}
focused = json.loads(subprocess.run(["herdr", "pane", "current"], env=env, capture_output=True, text=True).stdout)["result"]["pane"]["pane_id"]
info = call("pane.get", {"pane_id": focused})["scroll"]
if info is None:
    sys.exit(0)
rows = info["viewport_rows"] // 2 if step in ("half-up", "half-down") else int(step.lstrip("+-") or 1)
up = step in ("half-up",) or step.startswith("+")
offset = info["offset_from_bottom"] + (rows if up else -rows)
call("pane.scroll", {"pane_id": focused, "offset_from_bottom": max(0, min(offset, info["max_offset_from_bottom"]))})
